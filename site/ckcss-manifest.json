{
  "$schema": "https://ckcss.digitaltamam.com/ckcss-manifest.json",
  "name": "CKCSS",
  "version": "0.1.0-beta.1",
  "kind": "static-css-framework",
  "install": {
    "cdn": "https://cdn.jsdelivr.net/gh/kayacuneyd/ckcss@v0.1.0-beta.1/dist/ckcss.min.css",
    "selfHostedFile": "dist/ckcss.min.css",
    "requiresRuntimeJavaScript": false
  },
  "generationRules": [
    "Use documented ck- classes only.",
    "Prefer semantic HTML and native accessibility attributes.",
    "Use --ck- semantic tokens for theme overrides.",
    "Prefer native HTML interactions; Enhance JavaScript is optional."
  ],
  "layout": {
    "classes": ["ck-container", "ck-container--narrow", "ck-container--wide", "ck-stack", "ck-stack--compact", "ck-stack--relaxed", "ck-cluster", "ck-cluster--spread", "ck-grid", "ck-grid--2", "ck-grid--3", "ck-grid--auto-fit", "ck-sidebar", "ck-sidebar--end"]
  },
  "components": {
    "button": {"classes": ["ck-button", "ck-button--secondary", "ck-button--quiet", "ck-button--danger"], "elements": ["button", "a"], "states": ["disabled", "aria-pressed", "aria-expanded", "aria-busy"]},
    "card": {"classes": ["ck-card", "ck-card__header", "ck-card__body", "ck-card__footer"], "elements": ["article"], "states": ["data-ck-state=selected", "data-ck-state=loading"]},
    "form": {"classes": ["ck-field", "ck-field__label", "ck-field__help", "ck-field__error", "ck-input", "ck-select", "ck-textarea", "ck-choice", "ck-switch"], "requiredAccessibility": ["label", "aria-invalid with visible error text when invalid", "aria-describedby when help or error text exists"]},
    "feedback": {"classes": ["ck-badge", "ck-badge--success", "ck-badge--warning", "ck-badge--danger", "ck-alert", "ck-alert--success", "ck-alert--warning", "ck-alert--danger"]},
    "dataAndNavigation": {"classes": ["ck-table-wrap", "ck-table", "ck-breadcrumb", "ck-tabs", "ck-pagination", "ck-stepper", "ck-timeline", "ck-progress", "ck-nav", "ck-nav--stacked", "ck-dialog"]}
  },
  "themes": {
    "scopeAttribute": "data-ck-theme",
    "builtInValues": ["dark"],
    "semanticTokens": ["--ck-color-surface", "--ck-color-surface-muted", "--ck-color-text", "--ck-color-text-muted", "--ck-color-primary", "--ck-color-primary-hover", "--ck-color-focus", "--ck-color-border", "--ck-radius-md", "--ck-space-4"]
  },
  "documentation": {
    "humanGuide": "/ai.html",
    "components": "/components.html",
    "themes": "/themes.html",
    "download": "/download.html"
  }
}
